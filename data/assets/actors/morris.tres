[resource]
script = ExtResource("1_def")
id = &"morris"
kind = 3
display_name = "莫里斯（第一章 Boss · 蜡像师）"
source_dir = "assets/enemies"
script_path = "res://scripts/boss/morris.gd"
frame_size = 128
body_size = Vector2(30, 62)
states_dir = "res://scripts/boss/morris/states"
state_names = PackedStringArray("idle", "chase", "melee", "spray", "summon", "hurt", "death")
note = "右脸黑色烧伤印记 + 全镇唯一穿彩色衣服（青绿围裙）。**眼里有琥珀色高光，替身没有** —— 这是二阶段解谜的唯一线索。"
animations = [SubResource("anim_idle"), SubResource("anim_spray"), SubResource("anim_summon"), SubResource("anim_hit"), SubResource("anim_death")]

[resource]
script = ExtResource("1_def")
id = &"townsman"
kind = 2
display_name = "镇民"
source_dir = "assets/enemies"
script_path = "res://scripts/npc/townsman.gd"
frame_size = 64
body_size = Vector2(28, 54)
states_dir = "res://scripts/npc/states"
state_names = PackedStringArray("task", "staggered", "dazed", "chase", "hit", "death")
note = "灰衣。三种情绪：可对话 / 只看你 / 敌对；被击败后变茫然（不是自愿攻击）。"
animations = [SubResource("anim_idle"), SubResource("anim_task"), SubResource("anim_walk"), SubResource("anim_dazed"), SubResource("anim_hit"), SubResource("anim_death")]

{
  "npcs": {
    "lamplighter": {
      "id": "lamplighter",
      "name": "点灯人",
      "atlas": "npcs_a",
      "cell": 0,
      "lines": [
        "灯会记得你走过的路。别怕绕远，我总会在这里点亮下一盏。",
        "丰收祭那晚，镇上的火把也是这样一盏一盏点起来的……钟声一响，我又想不起来了。"
      ]
    },
    "mother": {
      "id": "mother",
      "name": "姑姑的老邻居",
      "atlas": "npcs_a",
      "cell": 1,
      "lines": [
        "你是她的侄子吧？葬礼的事，节哀。她一直留着你小时候的画。",
        "你的右脸……不，对不起。我不该一直盯着看。"
      ]
    },
    "waterman": {
      "id": "waterman",
      "name": "提水老人",
      "atlas": "npcs_a",
      "cell": 2,
      "lines": [
        "施工队从枯井里挖出了东西，警察拉了线。西边的楼梯通向美术馆前街。",
        "楼梯一层一层地走。你小时候总跟着那个扎双马尾的女孩跑上跑下。"
      ]
    },
    "seamstress": {
      "id": "seamstress",
      "name": "缝衣匠",
      "atlas": "npcs_a",
      "cell": 3,
      "lines": [
        "红线绷得太紧了。美工刀能割断它们，也能挡开那些坏掉的木偶。",
        "后台那只双马尾布偶，是道具师沃伊德帮一个男孩缝好的。眼睛一直完好。"
      ]
    },
    "bookseller": {
      "id": "bookseller",
      "name": "旧书商",
      "atlas": "npcs_b",
      "cell": 0,
      "lines": [
        "七面镜子，七个方向。旧报纸堆里，还压着一张没人领回的寻人启事。",
        "纸上的指控，和纸上的证词，有时是同一句话。"
      ]
    },
    "usher": {
      "id": "usher",
      "name": "检票人",
      "atlas": "npcs_b",
      "cell": 1,
      "lines": [
        "戏还没散场。顺着红线往上，找到后台的门。",
        "丰收祭那晚的演出，有两个孩子一直没有来。"
      ]
    },
    "clocksmith": {
      "id": "clocksmith",
      "name": "钟表修理匠",
      "atlas": "npcs_b",
      "cell": 2,
      "lines": [
        "两枚印记就开得了钟楼。发条外庭的楼梯通往上层，不要跳过台阶。",
        "你听得见齿轮的间隙了吗？握住那一瞬，时间就会慢下来。"
      ]
    },
    "conductor": {
      "id": "conductor",
      "name": "站务员",
      "atlas": "npcs_b",
      "cell": 3,
      "lines": [
        "早班车七点开。离开，或者留下来把事情弄清楚，都可以。",
        "这一次，可以出发了。"
      ]
    },
    "detective": {
      "id": "detective",
      "name": "刑警",
      "atlas": "detective",
      "cell": -1,
      "lines": [
        "施工队在枯井下挖出的遗骸，已经确认是玲。明天请到局里配合调查。",
        "你在询问时的表情……不太对劲。如果你记得什么，尽快告诉我。",
        "井边的警戒线还在。别擅自下去——我们会再派人。"
      ]
    }
  },

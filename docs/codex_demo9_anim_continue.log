r2, radius: float, width: float, tint: Color = Color.WHITE) -> void:\n \tfor i: int in range(48):\n \t\tstrand(host,\"red_thread\",center+Vector2.from_angle(TAU*i/48)*radius,center+Vector2.from_angle(TAU*(i+1)/48)*radius,width,tint)\n+\n+\n+static var _animation_manifest: Dictionary = {}\n+static var _animation_frames: Dictionary = {}\n+\n+static func animation_manifest() -> Dictionary:\n+\tif _animation_manifest.is_empty() and FileAccess.file_exists(\"res://data/exploration/animations.json\"):\n+\t\t_animation_manifest = JSON.parse_string(FileAccess.get_file_as_string(\"res://data/exploration/animations.json\"))\n+\treturn _animation_manifest\n+\n+static func default_clip(id: String, cell: int = -1) -> String:\n+\treturn str(animation_manifest().get(\"sources\",{}).get(id+\"/\"+str(cell),\"\"))\n+\n+static func has_clip(id: String) -> bool:\n+\treturn animation_manifest().get(\"clips\",{}).has(id)\n+\n+static func clip_info(id: String) -> Dictionary:\n+\treturn animation_manifest().get(\"clips\",{}).get(id,{})\n+\n+static func animation_source(texture: Texture2D) -> Dictionary:\n+\tif texture.has_meta(\"animation_source\"):\n+\t\treturn texture.get_meta(\"animation_source\")\n+\treturn {}\n+\n+static func source_id(texture: Texture2D) -> String:\n+\treturn str(animation_source(texture).get(\"id\",texture.resource_path.get_file().get_basename()))\n+\n+static func animation_index(id: String, age: float, duration: float = -1.0) -> int:\n+\tvar info: Dictionary = clip_info(id)\n+\tvar count: int = int(info.get(\"frames\",1))\n+\tvar length: float = duration if duration>0 else float(info.get(\"duration\",.8))\n+\tvar index: int = int(maxf(age,0)/length*count)\n+\treturn index%count if bool(info.get(\"loop\",true)) else mini(index,count-1)\n+\n+static func animation_frame(id: String, index: int) -> Texture2D:\n+\tvar key: String = id+\"/\"+str(index)\n+\tif _animation_frames.has(key):\n+\t\treturn _animation_frames[key]\n+\tvar info: Dictionary = clip_info(id)\n+\tif info.is_empty():\n+\t\treturn null\n+\tvar atlas := AtlasTexture.new()\n+\tatlas.atlas = load(str(info.path)) as Texture2D\n+\tvar size := Vector2(float(info.width),float(info.height))\n+\tvar cell: int = clampi(index,0,int(info.frames)-1)+int(info.get(\"offset\",0))\n+\tatlas.region = Rect2(Vector2(cell%int(info.columns),cell/int(info.columns))*size,size)\n+\tatlas.filter_clip = true\n+\tatlas.set_meta(\"animation_source\",{\"id\":str(info.source),\"cell\":int(info.get(\"cell\",-1))})\n+\tatlas.set_meta(\"animation_clip\",id)\n+\t_animation_frames[key] = atlas\n+\treturn atlas\n+\n+static func sprite(id: String, cell: int = -1, folder: String = \"actors\") -> Texture2D:\n+\tif folder == \"actors\":\n+\t\tvar clip: String = default_clip(id,cell)\n+\t\tif has_clip(clip):\n+\t\t\treturn animation_frame(clip,0)\n+\treturn still_sprite(id,cell,folder)\n+\n+static func moving_sprite(id: String, age: float) -> Texture2D:\n+\tvar clip: String = default_clip(id)\n+\tif has_clip(clip):\n+\t\treturn animation_frame(clip,animation_index(clip,age))\n+\treturn sprite(id)\ndiff --git a/scripts/exploration/exploration_keeper_limb.gd b/scripts/exploration/exploration_keeper_limb.gd\nindex e20de6e..84024b0 100644\n--- a/scripts/exploration/exploration_keeper_limb.gd\n+++ b/scripts/exploration/exploration_keeper_limb.gd\n@@ -35,11 +35,11 @@ func _draw() -> void:\n \t\tdraw_line(Vector2(-35,-3),Vector2(35,-3),Color(red,.4+progress*.5),4,true)\n \t\tdraw_arc(Vector2(0,-5),12+progress*18,PI,TAU,20,red,2,true)\n \t\treturn\n-\t# Forearm and five fingers, rising then sinking back.\n-\tvar rise: float = sin(clampf((_age-warning)/.4,0,1)*PI)\n-\tvar skin := Color(\"3a2a2c\")\n-\tvar wrist := Vector2(0,-92*rise)\n-\tdraw_line(Vector2.ZERO,wrist,skin,16,true)\n-\tfor i: int in range(5):\n-\t\tvar finger := Vector2.from_angle(-PI*.5+(i-2)*.32)\n-\t\tdraw_line(wrist,wrist+finger*30*rise,skin,5,true)\n+\t# Generated cels replace the former line-drawn hand; collision and timing are untouched.\n+\tvar elapsed: float = clampf((_age-warning)/.4,0,1)\n+\tvar clip: String = \"keeper_limb\"\n+\tvar texture: Texture2D = ExplorationArt.animation_frame(clip,mini(7,int(elapsed*8)))\n+\tif texture != null:\n+\t\tvar height: float = 122\n+\t\tvar width: float = height*texture.get_width()/texture.get_height()\n+\t\tdraw_texture_rect(texture,Rect2(-width*.5,-height,width,height),false)\n{\n  \"canvas\": [\n    1672,\n    941\n  ],\n  \"eyes\": [\n    {\n      \"id\": \"portrait_1_left_iris\",\n      \"portrait\": 1,\n      \"center\": [\n        165.5,\n        471.5\n      ],\n      \"path\": \"res://assets/environments/exploration/portraits/portrait_1_left_iris.png\",\n      \"size\": [\n        7,\n        7\n      ],\n      \"travel\": [\n        2.2,\n        0.8\n      ],\n      \"sclera_patch\": [\n        159,\n        468,\n        172,\n        475\n      ]\n    },\n    {\n      \"id\": \"portrait_1_right_iris\",\n      \"portrait\": 1,\n      \"center\": [\n        201.5,\n        471.5\n      ],\n      \"path\": \"res://assets/environments/exploration/portraits/portrait_1_right_iris.png\",\n      \"size\": [\n        7,\n        7\n      ],\n      \"travel\": [\n        2.2,\n        0.8\n      ],\n      \"sclera_patch\": [\n        195,\n        468,\n        208,\n        475\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom PIL import Image,ImageChops\nimport json,shutil\nroot=Path('.');m=json.loads((root/'data/exploration/animations.json').read_text());report={}\nfor name,v in m['clips'].items():\n im=Image.open(root/v['path'].removeprefix('res://'));w,h=v['width'],v['height'];bottom=[]\n for i in range(8):\n  a=v.get('offset',0)+i;x=a%v['columns']*w;y=a//v['columns']*h\n  box=im.crop((x,y,x+w,y+h)).getchannel('A').point(lambda v:255 if v>128 else 0).getbbox();bottom.append(box[3])\n report[name]={'bottom_pixels':bottom,'range_pixels':max(bottom)-min(bottom),'target_baseline':v['baseline']}\nassert max(v['range_pixels'] for v in report.values())<=3,report\nold=Image.open('tmp/demo9-anim/before/museum.png').convert('RGBA');new=Image.open('assets/environments/exploration/backgrounds/museum.png').convert('RGBA');diff=ImageChops.difference(old,new)\nfor r in [(58,407,297,550),(644,407,866,551),(1380,408,1615,550)]:diff.paste((0,0,0,0),r)\nassert not any(c.getbbox() for c in diff.split()),'museum changed outside portrait interiors'\n(root/'docs/demo9-animation-contact-validation.json').write_text(json.dumps({'clips':report,'museum_outside_portraits_unchanged':True},indent=2)+'\\\\n')\nbackup=root/'docs/demo9-animation-before';backup.mkdir(exist_ok=True)\nfor n in ['keeper_unmasked','museum']:shutil.copy2(root/f'tmp/demo9-anim/before/{n}.png',backup/f'{n}.png')\n# Preview the real independent iris textures composited over the generated blank sclera background.\ne=json.loads((root/'data/exploration/museum-eyes.json').read_text());frames=[]\nfor t in [-1,-.5,0,.5,1,.5,0,-.5]:\n im=new.copy()\n for v in e['eyes']:\n  iris=Image.open(root/v['path'].removeprefix('res://'));x,y=v['center'];dx,dy=v['travel'];im.alpha_composite(iris,(round(x-3.5+t*dx),round(y-3.5+t*dy)))\n im.crop((690,425,820,520)).resize((650,475),Image.Resampling.NEAREST).convert('RGB').save('tmp/demo9-anim/gaze-last.png')\n frames.append(im.crop((690,425,820,520)).resize((650,475),Image.Resampling.NEAREST).convert('RGB'))\nframes[0].save('docs/demo9-museum-gaze-closeup.gif',save_all=True,append_images=frames[1:],duration=180,loop=0)\nprint('77 clip foot baselines: max drift',max(v['range_pixels'] for v in report.values()),'px at 384px cel height; museum exterior pixels identical')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

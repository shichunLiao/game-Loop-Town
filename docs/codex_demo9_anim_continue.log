py:10:BG = ROOT / \"assets/environments/exploration/backgrounds\"\ntools/dev/export_demo9_share.py:22:    \"demo9-share-cast-keeper.png\": [\ntools/dev/export_demo9_share.py:23:        \"keeper_back.png\", \"keeper_hidden.png\", \"keeper_unmasked.png\",\ntools/dev/export_demo9_share.py:96:    for im, label in zip(imgs, labels):\ntools/dev/export_demo9_share.py:133:    mm, md = MID / \"museum_mid.png\", MID / \"museum_depth.png\"\ntools/dev/export_demo9_share.py:135:        dest = OUT / \"demo9-share-museum-mid.png\"\ntools/dev/export_demo9_share.py:136:        side_by_side([mm, md], [\"museum_mid\", \"museum_depth\"], 640).save(dest, \"PNG\", optimize=True)\ntools/dev/export_demo9_share.py:191:    overview_files = [\ntools/dev/export_demo9_share.py:192:        \"may_brush_strike.png\", \"void_lash.png\", \"keeper_unmasked.png\",\ntools/dev/export_demo9_share.py:195:    im = sheet(overview_files, cell=(240, 360), cols=6, title=\"Demo 9 · cast overview\")\ntools/dev/export_demo9_share.py:196:    dest = OUT / \"demo9-share-cast-overview.png\"\n","exit_code":0,"status":"completed"}}

eate_tween().set_parallel()\n\ttween.tween_property(visual,\"rotation\",side*1.45,.3)\n\ttween.tween_property(visual,\"position:y\",-16.0,.3)\n\nfunc _physics_process(delta: float) -> void:\n\t_clock += delta\n\t_invulnerability = maxf(0.0, _invulnerability - delta)\n\t_dash_cooldown = maxf(0.0, _dash_cooldown - delta)\n\tqueue_redraw()\n\tif not enabled:\n\t\treturn\n\tenergy = minf(100,energy+delta*7)\n\t_slow_cooldown = maxf(0,_slow_cooldown-delta)\n\t_combo_window = maxf(0,_combo_window-delta)\n\t_knockback = move_toward(_knockback,0,delta*900)\n\tif entangled > 0.0:\n\t\tentangled -= delta\n\t\t_entangle_tick -= delta\n\t\tif _entangle_tick <= 0.0:\n\t\t\t_entangle_tick = .4\n\t\t\thealth = maxi(1,health-3)\n\tconfused = maxf(0.0,confused-delta)\n\tif grip > 0:\n\t\t_knockback = 0.0\n\t\tif Input.is_action_just_pressed(\"jump\") or Input.is_action_just_pressed(\"move_left\") or Input.is_action_just_pressed(\"move_right\"):\n\t\t\tgrip -= 1\n\t_update_combat(delta)\n\tif _drop_timer>0:\n\t\t_drop_timer -= delta\n\t\tif _drop_timer<=0 and is_instance_valid(_drop_platform):\n\t\t\tremove_collision_exception_with(_drop_platform)\n\t\t\t_drop_platform = null\n\tvar on_floor_before: bool = is_on_floor()\n\t_coyote = 0.12 if on_floor_before else maxf(0.0, _coyote - delta)\n\t_buffer = maxf(0.0, _buffer - delta)\n\tif on_floor_before:\n\t\t_air_jump = false\n\t\t_last_ground_y = position.y\n\tif Input.is_action_just_pressed(\"jump\"):\n\t\tif Input.is_action_pressed(\"move_down\") and _try_drop():\n\t\t\t_buffer = 0\n\t\telse:\n\t\t\t_buffer = 0.14\n\tif grip > 0:\n\t\t_buffer = 0.0\n\tvar direction: float = Input.get_axis(\"move_left\", \"move_right\")*(-1.0 if confused > 0.0 else 1.0)\n\tif direction != 0.0:\n\t\tfacing = direction\n\tvar climbing: bool = near_vine and grip == 0 and session != null and session.has(\"vine\") and Input.get_axis(\"move_up\", \"move_down\") != 0.0\n\tif climbing:\n\t\t\ttake_damage(100)\n\tif global_position.y > 6200.0:\n\t\ttake_damage(100)\n\nfunc take_damage(amount: int) -> void:\n\tif _invulnerability > 0.0 or not enabled:\n\t\treturn\n\thealth = maxi(0, health - amount)\n\t_invulnerability = 1.1\n\tvelocity.y = -300.0\n\tget_node(\"/root/AudioManager\").play_sfx(\"sfx_hurt\")\n\tif health <= 0:\n\t\tenabled = false\n\t\tstate = \"death\"\n\t\tdied.emit()\n\nfunc receive_hit(amount: int, origin: Vector2, kind: String = \"hit\") -> void:\n\tif _invulnerability > 0 or not enabled:\n\t\treturn\n\t_knockback = signf(global_position.x-origin.x)*330\n\tattack_phase = \"ready\"\n\tif kind == \"puppet\":\n\t\tcloth += 1\n\telif kind == \"void_lash\":\n\t\tentangled = 1.6\n\telif kind in [\"may_slash\", \"wax_claw\"]:\n\t\tpaper += 1\n\t\tlast_may_kind = \"may_slash\"\n\telif kind == \"statue\":\n\t\tplaster += 1\n\t\tlast_may_kind = \"statue\"\nclass_name ExplorationKeeperFigure\nextends Node2D\n## The keeper: a figure in a wide-brimmed hat, features lost under the brim, back turned,\n## winding a great key. At the top of the tower (leaves_on set) he turns as Jerry comes near,\n## and takes the hat off when Jerry reaches him: the face underneath is Jerry's own.\n## Art by Codex (Demo 9): keeper_back, keeper_hidden, keeper_unmasked.\n\nconst HEIGHT := {\"keeper_back\":124.0,\"keeper_hidden\":118.0,\"keeper_unmasked\":118.0}\nconst TURN_DISTANCE: float = 380\nconst UNMASK_DISTANCE: float = 190\n\nvar session: ExplorationSession\nvar leaves_on: String = \"\"\nvar visual: Sprite2D\nvar _pose: String = \"\"\nvar _clock: float = 0\n\nfunc _ready() -> void:\n\tvisual = ExplorationArt.visual(self,\"keeper_back\",HEIGHT[\"keeper_back\"])\n\t_pose = \"keeper_back\"\n\tvisual.position.x = 25\n\tz_index = 4\n\nfunc _process(delta: float) -> void:\n\t_clock += delta\n\tif not leaves_on.is_empty() and session.has(leaves_on):\n\t\tleaves_on = \"\"\n\t\tvanish()\n\tif not leaves_on.is_empty():\n\t\tvar player: Node2D = get_tree().get_first_node_in_group(\"exploration_player\") as Node2D\n\t\tif player!=null:\n\t\t\tvar distance: float = absf(player.global_position.x-global_position.x)\n\t\t\t_wear(\"keeper_unmasked\" if distance<UNMASK_DISTANCE else \"keeper_hidden\" if distance<TURN_DISTANCE else \"keeper_back\")\n\t\t\tif _pose!=\"keeper_back\":\n\t\t\t\tvisual.flip_h = player.global_position.x>global_position.x\n\t# Winding: the back sways a little with each turn of the key.\n\tif _pose==\"keeper_back\":\n\t\tvisual.rotation = sin(_clock*1.5)*.025\n\telse:\n\t\tvisual.rotation = 0\n\tqueue_redraw()\n\nfunc _wear(pose: String) -> void:\n\tif pose==_pose:\n\t\treturn\n\t_pose = pose\n\tvisual.texture = ExplorationArt.sprite(pose)\n\tvisual.scale = Vector2.ONE*float(HEIGHT[pose])/visual.texture.get_height()\n\tvisual.position.y = -float(HEIGHT[pose])*.5\n\t# keeper_back carries the key on its right; keep his body, not the key, over his feet.\n\tvisual.position.x = 25.0 if pose==\"keeper_back\" else 0.0\n\nfunc warp_to(point: Vector2) -> void:\n\tvar tween := create_tween()\n\ttween.tween_property(self,\"modulate:a\",0,.25)\n\ttween.tween_callback(func(): position = point)\n\ttween.tween_property(self,\"modulate:a\",1,.35)\n\nfunc vanish() -> void:\n\tvar tween := create_tween()\n\ttween.tween_property(self,\"modulate:a\",0,1.0)\n\ttween.tween_callback(queue_free)\n\nfunc _draw() -> void:\n\t# A faint warm halo so the dark figure reads against the red tower.\n\tdraw_circle(Vector2(0,-62),78,Color(.95,.72,.42,.10))\n\tdraw_circle(Vector2(0,-62),54,Color(.95,.72,.42,.14))\n","exit_code":0,"status":"completed"}}

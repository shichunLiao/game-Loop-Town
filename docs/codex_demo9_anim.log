ts/exploration/exploration_building_feature.gd\nscripts/exploration/exploration_keeper_limb.gd\nscripts/exploration/exploration_hazard.gd\nscripts/exploration/exploration_keeper_figure.gd\nscripts/exploration/exploration_lift_feature.gd\nscripts/exploration/exploration_backdrop.gd\nscripts/exploration/exploration_actions.gd\nscripts/exploration/exploration_session.gd\nscripts/exploration/exploration_enemy.gd\nscripts/exploration/exploration_art.gd\nscripts/exploration/exploration_world_map.gd\nscripts/exploration/exploration_hud.gd\nscripts/exploration/exploration_projectile.gd\nscripts/exploration/exploration_ling_mud.gd\nscripts/exploration/exploration_scenery.gd\nscripts/exploration/exploration_room.gd\nscripts/exploration/exploration_fury_scene.gd\nscripts/exploration/exploration_ling_figure.gd\nscripts/exploration/exploration_morris_double.gd\nscripts/exploration/exploration_keeper_chase.gd\nscripts/exploration/exploration_ling_hand.gd\nscripts/exploration/exploration_ling_knot.gd\nscripts/exploration/exploration_building.gd\nscripts/exploration/exploration_demo.gd\nscripts/exploration/exploration_void_boss.gd\nscripts/exploration/exploration_hit_area.gd\nscripts/exploration/exploration_void_thread.gd\nscripts/exploration/exploration_platform.gd\ndetective.png\ndetective.png.import\nenemies_a.png\nenemies_a.png.import\nenemies_b.png\nenemies_b.png.import\nfury_idle.png\nfury_idle.png.import\nfury_lunge.png\nfury_lunge.png.import\nfury_punch.png\nfury_punch.png.import\nhero.png\nhero.png.import\nkeeper_back.png\nkeeper_back.png.import\nkeeper_hidden.png\nkeeper_hidden.png.import\nkeeper_unmasked.png\nkeeper_unmasked.png.import\nling_crouch.png\nling_crouch.png.import\nling_giant.png\nling_giant.png.import\nling_hand.png\nling_hand.png.import\nmay_brush.png\nmay_brush.png.import\nmay_brush_strike.png\nmay_brush_strike.png.import\nmay_idle.png\nmay_idle.png.import\nmay_slash.png\nmay_slash.png.import\nmay_statue.png\nmay_statue.png.import\nmay_summon.png\nmay_summon.png.import\nmay_windup.png\nmay_windup.png.import\nmorris.png\nmorris.png.import\nmorris_actions.png\nmorris_actions.png.import\nmorris_actions_v2.png\nmorris_actions_v2.png.import\nmorris_false.gdshader\nmorris_false.gdshader.uid\nmorris_forms.png\nmorris_forms.png.import\nmorris_forms_v2.png\nmorris_forms_v2.png.import\nnpcs_a.png\nnpcs_a.png.import\nnpcs_b.png\nnpcs_b.png.import\nrim_light.gdshader\nrim_light.gdshader.uid\nvoid_command.png\nvoid_command.png.import\nvoid_frenzy.png\nvoid_frenzy.png.import\nvoid_idle.png\nvoid_idle.png.import\nvoid_lash.png\nvoid_lash.png.import\nvoid_puppet.png\nvoid_puppet.png.import\nextends SceneTree\n## Demo 9: every story 1.1 character uses the Codex art. Spawns each boss in its own room,\n## forces each pose and checks which PNG the sprite shows. Run with a window (not --headless)\n## to also save screenshots to docs/exploration-demo/v9-*.png.\n\nvar demo: Node2D\nvar failures: Array[String] = []\nvar passes: int = 0\nvar shots: bool = DisplayServer.get_name()!=\"headless\"\n\nconst SPRITES: Array[String] = [\"may_idle\",\"may_windup\",\"may_slash\",\"may_summon\",\"may_brush\",\"may_brush_strike\",\"may_statue\",\n\t\"void_idle\",\"void_command\",\"void_lash\",\"void_frenzy\",\"void_puppet\",\"keeper_back\",\"keeper_hidden\",\"keeper_unmasked\",\n\t\"fury_idle\",\"fury_lunge\",\"fury_punch\",\"ling_giant\",\"ling_crouch\",\"ling_hand\"]\n\nfunc _initialize() -> void:\n\t_run.call_deferred()\n\nfunc check(ok: bool, description: String) -> void:\n\tif ok:\n\t\tpasses += 1\n\t\tprint(\"PASS \",description)\n\telse:\n\t\tfailures.append(description)\n\t\tprint(\"FAIL \",description)\n\nfunc frames(count: int) -> void:\n\tfor i: int in range(count):\n\t\tawait process_frame\n\nfunc shows(sprite: Sprite2D, id: String) -> bool:\n\tif sprite==null or sprite.texture==null:\n\t\treturn false\n\tvar texture: Texture2D = sprite.texture\n\tif texture is AtlasTexture:\n\t\ttexture = (texture as AtlasTexture).atlas\n\treturn texture.resource_path.ends_with(\"/\"+id+\".png\")\n\nfunc shot(name: String) -> void:\n\tif not shots:\n\t\treturn\n\tawait frames(3)\n\troot.get_viewport().get_texture().get_image().save_png(\"res://docs/exploration-demo/v9-\"+name+\".png\")\n\nfunc enter(room_id: String, at: Vector2, flags: Array = []) -> void:\n\tdemo.start_game(false,room_id)\n\tfor flag: String in flags:\n\t\tdemo.session.acquire(flag)\n\tif not flags.is_empty():\n\t\tdemo.load_room(room_id)\n\tdemo.player.position = at\n\tdemo.player.enabled = false\n\tdemo.camera.reset_smoothing()\n\tawait frames(12)\n\nfunc boss() -> Node:\n\treturn root.get_tree().get_first_node_in_group(\"exploration_boss\")\n\nfunc _run() -> void:\n\troot.get_node(\"SaveManager\").exploration_slot_name = \"exploration_qa\"\n\tfor id: String in SPRITES:\n\t\tcheck(ExplorationArt.sprite(id)!=null,\"Codex sprite loads: \"+id)\n\tdemo = (load(\"res://scenes/exploration/ExplorationDemo.tscn\") as PackedScene).instantiate()\n\tdemo.set(\"_story_slot\",\"exploration_qa\")\n\troot.add_child(demo)\n\tcurrent_scene = demo\n\tawait frames(5)\n\n\t# May Morley in the endless corridor.\n\tawait enter(\"wax_museum\",Vector2(2780,1137))\n\tvar may: Node = boss()\n\tcheck(may is ExplorationBoss,\"May Morley spawns in the museum\")\n\tmay.set_physics_process(false)\n\tfor pose: Array in [[1,\"sleep\",\"fan\",\"may_idle\"],[1,\"windup\",\"cleave\",\"may_windup\"],[1,\"active\",\"cleave\",\"may_slash\"],\n\t\t\t[2,\"active\",\"copies\",\"may_summon\"],[3,\"recover\",\"rain\",\"may_brush\"],[3,\"active\",\"rush\",\"may_brush_strike\"]]:\n\t\tmay.phase = pose[0]\n\t\tmay.state = pose[1]\n\t\tmay.attack = pose[2]\n\t\tmay._visual_update()\n\t\tcheck(shows(may.visual,pose[3]),\"May phase %d %s %s shows %s\" % [pose[0],pose[1],pose[2],pose[3]])\n\t\tif pose[3] in [\"may_idle\",\"may_brush\",\"may_brush_strike\"]:\n\t\t\tawait shot(\"may-\"+str(pose[3]).trim_prefix(\"may_\"))\n\tmay.phase = 2\n\tmay.state = \"recover\"\n\tvar double := ExplorationMorrisDouble.new()\n\tdouble.spec = {\"id\":\"qa_statue\",\"type\":\"wax_walker\",\"pos\":[2600,1140],\"patrol\":0}\n\tdouble.session = demo.session\n\tdouble.summoner = may\n\tdouble.position = Vector2(2600,1140)\n\tdemo.room.actors.add_child(double)\n\tawait frames(3)\n\tcheck(shows(double.visual,\"may_statue\"),\"Statue double shows may_statue\")\n\tawait shot(\"may-statue\")\n\n\t# Void on the backstage stage.\n\tawait enter(\"back_stage\",Vector2(1500,937))\n\tvar void_boss: Node = boss()\n\tcheck(void_boss is ExplorationVoidBoss,\"Void spawns backstage\")\n\tvoid_boss._wake()\n\tawait frames(4)\n\tvoid_boss.set_physics_process(false)\n\tvar puppets: Array = root.get_tree().get_nodes_in_group(\"void_owned\").filter(func(n): return n is ExplorationVoidPuppet)\n\tcheck(not puppets.is_empty() and shows(puppets[0].visual,\"void_puppet\"),\"Void's seat puppets show void_puppet\")\n\tfor pose: Array in [[1,\"recover\",\"command\",\"void_idle\"],[1,\"windup\",\"command\",\"void_command\"],[2,\"active\",\"lash\",\"void_lash\"],[3,\"recover\",\"rain\",\"void_frenzy\"]]:\n\t\tvoid_boss.phase = pose[0]\n\t\tvoid_boss.state = pose[1]\n\t\tvoid_boss.attack = pose[2]\n\t\tvoid_boss._visual_update()\n\t\tcheck(shows(void_boss.visual,pose[3]),\"Void phase %d %s %s shows %s\" % [pose[0],pose[1],pose[2],pose[3]])\n\t\tif pose[3] in [\"void_idle\",\"void_lash\"]:\n\t\t\tawait shot(str(pose[3]).replace(\"_\",\"-\"))\n\n\t# The keeper at the top of the tower turns, then takes off his hat.\n\tawait enter(\"clock_top\",Vector2(300,1137))\n\tvar keepers: Array = demo.room.find_children(\"*\",\"ExplorationKeeperFigure\",true,false)\n\tvar keeper: ExplorationKeeperFigure = keepers.front() if not keepers.is_empty() else null\n\tcheck(keeper!=null and shows(keeper.visual,\"keeper_back\"),\"Keeper winds the key with his back turned\")\n\tawait shot(\"keeper-back\")\n\tif keeper!=null:\n\t\tdemo.player.position = Vector2(keeper.global_position.x-300,keeper.global_position.y-3)\n\t\tawait frames(3)\n\t\tcheck(shows(keeper.visual,\"keeper_hidden\"),\"Keeper turns, face hidden under the brim\")\n\t\tdemo.player.position = Vector2(keeper.global_position.x-120,keeper.global_position.y-3)\n\t\tawait frames(3)\n\t\tcheck(shows(keeper.visual,\"keeper_unmasked\"),\"Keeper takes off the hat: Jerry's face\")\n\t\tawait shot(\"keeper-unmasked\")\n\n\t# Fury at the well mouth, and the player wearing his body.\n\tawait enter(\"dry_well\",Vector2(3000,1237))\n\tvar scenes: Array = demo.room.find_children(\"*\",\"ExplorationFuryScene\",true,false)\n\tvar fury_scene: Node = scenes.front() if not scenes.is_empty() else null\n\tcheck(fury_scene!=null,\"Fury scene is in the dry well\")\n\tif fury_scene!=null:\n\t\tvar fury: Node = fury_scene.body if is_instance_valid(fury_scene.body) else null\n\t\tif fury==null:\n\t\t\tfury = ExplorationFuryBody.new()\n\t\t\tfury.spec = {\"id\":\"qa_fury\",\"type\":\"fury\",\"pos\":[3200,1240]}\n\t\t\tfury.session = demo.session\n\t\t\tfury.position = Vector2(3200,1240)\n\t\t\tdemo.room.actors.add_child(fury)\n\t\t\tawait frames(2)\n\t\tfury._visual_update()\n\t\tcheck(shows(fury.visual,\"fury_idle\"),\"Fury stands as fury_idle\")\n\t\tawait shot(\"fury\")\n\t\tfury._step = \"lunge\"\n\t\tfury._visual_update()\n\t\tcheck(shows(fury.visual,\"fury_lunge\"),\"Fury lunges as fury_lunge\")\n\t\tawait shot(\"fury-lunge\")\n\t\tfury.become_jerry(60)\n\t\tfury._visual_update()\n\t\tcheck(shows(fury.visual,\"hero\"),\"After the flash the other body is Jerry\")\n\tdemo.player.wear(\"fury_idle\",118,-1,\"fury_punch\",true)\n\tdemo.player.enabled = true\n\tawait frames(2)\n\tcheck(shows(demo.player.visual,\"fury_idle\"),\"Player wears fury_idle\")\n\tdemo.player.enabled = false\n\tdemo.player.attack_phase = \"active\"\n\tdemo.player._worn_pose()\n\tcheck(shows(demo.player.visual,\"fury_punch\"),\"Player throws fury_punch while a blow is out\")\n\tdemo.player.enabled = false\n\n\t# Ling at the bottom of the well, and the real Ling in the corner.\n\tawait enter(\"well_interior\",Vector2(700,2837),[\"fury_done\"])\n\tvar ling: Node = boss()\n\tcheck(ling is ExplorationLingBoss,\"Ling spawns once Fury has pushed Jerry in\")\n\tif ling is ExplorationLingBoss:\n\t\tling.set_physics_process(false)\n\t\tling.state = \"recover\"\n\t\tling._rise = 1.0\n\t\tling._wrap = .6\n\t\tling._visual_update()\n\t\tawait shot(\"ling-giant\")\n\tvar hand := ExplorationLingHand.new()\n\thand.boss = ling\n\thand.session = demo.session\n\thand.warning = 0\n\thand.position = Vector2(900,2840)\n\tdemo.room.actors.add_child(hand)\n\tawait frames(2)\n\tcheck(is_instance_valid(hand),\"Mud hand draws without errors\")\n\tdemo.session.acquire(\"boss_ling\")\n\tdemo.load_room(\"well_interior\")\n\tdemo.player.position = Vector2(1500,2837)\n\tdemo.player.enabled = false\n\tdemo.camera.reset_smoothing()\n\tawait create_timer(3.6).timeout\n\tvar figures: Array = demo.room.find_children(\"*\",\"ExplorationLingFigure\",true,false)\n\tcheck(not figures.is_empty() and figures.front().modulate.a>.9,\"The real Ling appears in the corner\")\n\tawait shot(\"ling-crouch\")\n\n\tdemo.hud.show_cast()\n\tawait frames(3)\n\tcheck(true,\"Cast page renders the story 1.1 cast\")\n\tawait shot(\"cast\")\n\n\tprint(\"V9_ART_QA %d passed, %d failed\" % [passes,failures.size()])\n\tquit(1 if failures.size()>0 else 0)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"find .. -name AGENTS.md -print; cat scripts/exploration/exploration_art.gd; rg -n 'ExplorationArt|visual\\\\.|sprite\\\\(|_process|_visual_update|POSE_HEIGHT' scripts/exploration/{exploration_player,exploration_enemy,exploration_npc,exploration_keeper_figure,exploration_ling_hand,exploration_backdrop,exploration_room}.gd\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"find .. -name AGENTS.md -print; cat scripts/exploration/exploration_art.gd; rg -n 'ExplorationArt|visual\\\\.|sprite\\\\(|_process|_visual_update|POSE_HEIGHT' scripts/exploration/{exploration_player,exploration_enemy,exploration_npc,exploration_keeper_figure,exploration_ling_hand,exploration_backdrop,exploration_room}.gd\"","aggregated_output":"../agent-skills/software-dev/hyperframes/AGENTS.md\n../agent-skills/software-dev/archify/AGENTS.md\n../agent-skills/software-dev/orca/AGENTS.md\nclass_name ExplorationArt\nextends RefCounted\n## Atlas regions are metadata; original generated PNG pixels remain untouched.\n\nstatic var _textures: Dictionary = {}\nstatic var _actors: Dictionary = {}\nstatic var _regions: Dictionary = {}\nstatic var _anchors: Dictionary = {}\nstatic var _feet: Dictionary = {}\n\nstatic func foot_gap(id: String,cell: int = -1) -> float:\n\tif _anchors.is_empty() and FileAccess.file_exists(\"res://data/exploration/art-anchors.json\"):\n\t\t_anchors = JSON.parse_string(FileAccess.get_file_as_string(\"res://data/exploration/art-anchors.json\"))\n\treturn float(_anchors.get(id+\"/\"+str(cell),{}).get(\"bottom_gap\",0))\n\nstatic func actors() -> Dictionary:\n\tif _actors.is_empty():\n\t\t_actors = JSON.parse_string(FileAccess.get_file_as_string(\"res://data/exploration/actors.json\"))\n\treturn _actors\n\nstatic func sprite(id: String, cell: int = -1, folder: String = \"actors\") -> Texture2D:\n\tvar key: String = folder+\"/\"+id+\"/\"+str(cell)\n\tif _textures.has(key):\n\t\treturn _textures[key]\n\tvar path: String = \"res://assets/environments/exploration/\"+folder+\"/\"+id+\".png\"\n\tif not ResourceLoader.exists(path):\n\t\treturn null\n\tvar texture: Texture2D = load(path) as Texture2D\n\tif _regions.is_empty() and FileAccess.file_exists(\"res://data/exploration/art-regions.json\"):\n\t\t_regions = JSON.parse_string(FileAccess.get_file_as_string(\"res://data/exploration/art-regions.json\"))\n\tvar lookup: String = id+\"/\"+str(cell)\n\tif _regions.has(lookup):\n\t\tvar region: Array = _regions[lookup]\n\t\tvar atlas := AtlasTexture.new()\n\t\tatlas.atlas = texture\n\t\tatlas.region = Rect2(float(region[0]),float(region[1]),float(region[2]),float(region[3]))\n\t\tatlas.filter_clip = true\n\t\ttexture = atlas\n\telif cell >= 0:\n\t\tvar atlas := AtlasTexture.new()\n\t\tatlas.atlas = texture\n\t\tatlas.region = Rect2((cell%2)*texture.get_width()*.5,(cell/2)*texture.get_height()*.5,texture.get_width()*.5,texture.get_height()*.5)\n\t\ttexture = atlas\n\t_textures[key] = texture\n\treturn texture\n\nstatic func visual(host: Node2D, id: String, height: float, cell: int = -1) -> Sprite2D:\n\tvar visual := Sprite2D.new()\n\tvisual.texture = sprite(id,cell)\n\tif visual.texture != null:\n\t\tvisual.scale = Vector2.ONE * height / visual.texture.get_height()\n\tvisual.position.y = -height*.5\n\tvar material := ShaderMaterial.new()\n\tmaterial.shader = load(\"res://assets/environments/exploration/actors/rim_light.gdshader\") as Shader\n\tvisual.material = material\n\thost.add_child(visual)\n\treturn visual\n\n## Where the feet stand across a sprite, 0..1 from the left edge: the mean x of opaque pixels\n## in the bottom rows. Wide poses (a whip, a brush, a lunge) are not centred on the body.\nstatic func foot_center(id: String) -> float:\n\tif _feet.has(id):\n\t\treturn _feet[id]\n\tvar result: float = .5\n\tvar texture: Texture2D = sprite(id)\n\tif texture!=null and not texture is AtlasTexture:\n\t\tvar image: Image = texture.get_image()\n\t\tif image!=null:\n\t\t\tif image.is_compressed():\n\t\t\t\timage.decompress()\n\t\t\tvar total: float = 0\n\t\t\tvar count: int = 0\n\t\t\tvar w: int = image.get_width()\n\t\t\tvar h: int = image.get_height()\n\t\t\tfor y: int in range(int(h*.93),h,3):\n\t\t\t\tfor x: int in range(0,w,4):\n\t\t\t\t\tif image.get_pixel(x,y).a>.5:\n\t\t\t\t\t\ttotal += x\n\t\t\t\t\t\tcount += 1\n\t\t\tif count>0:\n\t\t\t\tresult = total/count/w\n\t_feet[id] = result\n\treturn result\n\n## Local x for a sprite drawn left-facing (flipped when facing right) so its feet sit on the origin.\nstatic func foot_shift(id: String, texture: Texture2D, scale_x: float, flipped: bool) -> float:\n\tvar shift: float = (.5-foot_center(id))*texture.get_width()*scale_x\n\treturn -shift if flipped else shift\n\n## Draw generated horizontal prop pixels along a segment; collision stays with callers.\nstatic func strand(host: Node2D, id: String, start: Vector2, end: Vector2, width: float, tint: Color = Color.WHITE) -> void:\n\tvar texture: Texture2D = sprite(id,0 if id==\"red_thread\" else -1,\"props\")\n\tif texture==null or start.distance_to(end)<.01:\n\t\treturn\n\thost.draw_set_transform(start,(end-start).angle())\n\thost.draw_texture_rect(texture,Rect2(0,-width*.5,start.distance_to(end),width),false,tint)\n\thost.draw_set_transform(Vector2.ZERO)\n\nstatic func thread_ring(host: Node2D, center: Vector2, radius: float, width: float, tint: Color = Color.WHITE) -> void:\n\tfor i: int in range(48):\n\t\tstrand(host,\"red_thread\",center+Vector2.from_angle(TAU*i/48)*radius,center+Vector2.from_angle(TAU*(i+1)/48)*radius,width,tint)\nscripts/exploration/exploration_npc.gd:16:\tdata = ExplorationArt.actors()[\"npcs\"][str(spec.get(\"type\",spec[\"id\"]))].duplicate(true)\nscripts/exploration/exploration_npc.gd:20:\tif ExplorationArt.sprite(atlas_id, cell) == null:\nscripts/exploration/exploration_npc.gd:23:\tvisual = ExplorationArt.visual(self, atlas_id, 120, cell)\nscripts/exploration/exploration_npc.gd:72:func _process(delta: float) -> void:\nscripts/exploration/exploration_npc.gd:81:\tvisual.rotation = sin(_clock*1.7+int(data[\"cell\"]))*0.014\nscripts/exploration/exploration_npc.gd:82:\tvisual.position.y = -60+sin(_clock*2.0)*1.1\nscripts/exploration/exploration_ling_hand.gd:20:func _physics_process(delta: float) -> void:\nscripts/exploration/exploration_ling_hand.gd:35:\t\tvar marker: Texture2D = ExplorationArt.sprite(\"ground_hand\",-1,\"props\")\nscripts/exploration/exploration_ling_hand.gd:41:\tvar hand: Texture2D = ExplorationArt.sprite(\"ling_hand\")\nscripts/exploration/exploration_player.gd:74:\tvisual = ExplorationArt.visual(self,\"hero\",105)\nscripts/exploration/exploration_player.gd:80:func _physics_process(delta: float) -> void:\nscripts/exploration/exploration_player.gd:159:\tvisual.flip_h = (facing < 0) != _worn_faces_left\nscripts/exploration/exploration_player.gd:160:\tvisual.rotation = clampf(velocity.x/6000,-.07,.07) if is_on_floor() else -.06*facing\nscripts/exploration/exploration_player.gd:161:\tvisual.position.y = -body_height*.5 + (sin(_clock*17)*2 if state == \"run\" else sin(_clock*2)*.7)\nscripts/exploration/exploration_player.gd:162:\tvisual.scale.y = (body_height/visual.texture.get_height()) * (1.0+sin(_clock*17)*.025 if state==\"run\" else 1.0)\nscripts/exploration/exploration_player.gd:163:\tvisual.modulate = Color.WHITE.lerp(Color(\"e3c3ae\"),minf(1,cloth/6.0))\nscripts/exploration/exploration_player.gd:167:\tvisual.modulate = paint_tint\nscripts/exploration/exploration_player.gd:168:\tvisual.modulate.a = .35 if _invulnerability>0 and int(_clock*15)%2==0 else 1.0\nscripts/exploration/exploration_player.gd:171:\t\tvisual.rotation += pose*facing*(-1 if combo==2 else 1)\nscripts/exploration/exploration_player.gd:172:\t\tvisual.position.x = (-5 if attack_phase==\"windup\" else 8)*facing+_worn_shift()\nscripts/exploration/exploration_player.gd:173:\t\tvisual.scale.y *= .94 if attack_phase==\"windup\" else 1.035\nscripts/exploration/exploration_player.gd:175:\t\tvisual.position.x = move_toward(visual.position.x,_worn_shift(),delta*90)\nscripts/exploration/exploration_player.gd:324:\tvisual.texture = ExplorationArt.sprite(atlas,cell)\nscripts/exploration/exploration_player.gd:325:\tvisual.scale = Vector2.ONE*height/visual.texture.get_height()\nscripts/exploration/exploration_player.gd:329:\t_worn_rest = visual.texture\nscripts/exploration/exploration_player.gd:330:\t_worn_attack = ExplorationArt.sprite(attack_pose) if not attack_pose.is_empty() else null\nscripts/exploration/exploration_player.gd:335:\tif not _worn_faces_left or visual.texture==null:\nscripts/exploration/exploration_player.gd:337:\tvar id: String = visual.texture.resource_path.get_file().get_basename()\nscripts/exploration/exploration_player.gd:338:\treturn ExplorationArt.foot_shift(id,visual.texture,visual.scale.x,visual.flip_h)\nscripts/exploration/exploration_player.gd:344:\tif visual.texture!=texture:\nscripts/exploration/exploration_player.gd:345:\t\tvisual.texture = texture\nscripts/exploration/exploration_player.gd:346:\t\tvisual.scale.x = body_height/texture.get_height()\nscripts/exploration/exploration_enemy.gd:26:\t\tdata = ExplorationArt.actors()[\"enemies\"][str(spec[\"type\"])]\nscripts/exploration/exploration_enemy.gd:39:\tvisual = ExplorationArt.visual(self,str(data[\"atlas\"]),float(data[\"height\"]),int(data.get(\"cell\",-1)))\nscripts/exploration/exploration_enemy.gd:44:func _physics_process(delta: float) -> void:\nscripts/exploration/exploration_enemy.gd:106:\t_visual_update()\nscripts/exploration/exploration_enemy.gd:172:func _visual_update() -> void:\nscripts/exploration/exploration_enemy.gd:173:\tvisual.flip_h = facing > 0\nscripts/exploration/exploration_enemy.gd:174:\tvisual.position.y = -float(data[\"height\"])*.5 + sin(_clock*(8 if absf(velocity.x)>1 else 2))*2\nscripts/exploration/exploration_enemy.gd:175:\tvisual.rotation = sin(_clock*8)*.025 if absf(velocity.x)>1 else 0\nscripts/exploration/exploration_enemy.gd:176:\tvisual.modulate = Color(3,2,1) if _flash>0 else Color(1.1,.65,.5) if state==\"windup\" else Color.WHITE\nscripts/exploration/exploration_backdrop.gd:52:func _process(delta: float) -> void:\nscripts/exploration/exploration_keeper_figure.gd:19:\tvisual = ExplorationArt.visual(self,\"keeper_back\",HEIGHT[\"keeper_back\"])\nscripts/exploration/exploration_keeper_figure.gd:21:\tvisual.position.x = 25\nscripts/exploration/exploration_keeper_figure.gd:24:func _process(delta: float) -> void:\nscripts/exploration/exploration_keeper_figure.gd:35:\t\t\t\tvisual.flip_h = player.global_position.x>global_position.x\nscripts/exploration/exploration_keeper_figure.gd:38:\t\tvisual.rotation = sin(_clock*1.5)*.025\nscripts/exploration/exploration_keeper_figure.gd:40:\t\tvisual.rotation = 0\nscripts/exploration/exploration_keeper_figure.gd:47:\tvisual.texture = ExplorationArt.sprite(pose)\nscripts/exploration/exploration_keeper_figure.gd:48:\tvisual.scale = Vector2.ONE*float(HEIGHT[pose])/visual.texture.get_height()\nscripts/exploration/exploration_keeper_figure.gd:49:\tvisual.position.y = -float(HEIGHT[pose])*.5\nscripts/exploration/exploration_keeper_figure.gd:51:\tvisual.position.x = 25.0 if pose==\"keeper_back\" else 0.0\nscripts/exploration/exploration_room.gd:106:\t\tdecoration.texture = ExplorationArt.sprite(str(entry[\"asset\"]),int(entry[\"cell\"]),str(entry[\"folder\"]))\nscripts/exploration/exploration_room.gd:112:\t\tdecoration.position.y += ExplorationArt.foot_gap(str(entry[\"asset\"]),int(entry[\"cell\"]))*decoration.scale.y\nscripts/exploration/exploration_room.gd:188:func _process(_delta: float) -> void:\nscripts/exploration/exploration_room.gd:199:\t\t\tExplorationArt.strand(self,\"vine\",Vector2(x+offset,float(entry[1])),Vector2(x+offset,float(entry[1])+float(entry[3])),28)\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'cat data/exploration/actors.json; cat scripts/exploration/exploration_backdrop.gd; cat scripts/exploration/exploration_ling_hand.gd; cat tools/dev/export_demo9_scale_feet.py'","aggregated_output":"{\n  \"npcs\": {\n    \"lamplighter\": {\n      \"id\": \"lamplighter\",\n      \"name\": \"点灯人\",\n      \"atlas\": \"npcs_a\",\n      \"cell\": 0,\n      \"lines\": [\n        \"灯会记得你走过的路。别怕绕远，我总会在这里点亮下一盏。\",\n        \"丰收祭那晚，镇上的火把也是这样一盏一盏点起来的……钟声一响，我又想不起来了。\"\n      ]\n    },\n    \"mother\": {\n      \"id\": \"mother\",\n      \"name\": \"姑姑的老邻居\",\n      \"atlas\": \"npcs_a\",\n      \"cell\": 1,\n      \"lines\": [\n        \"你是她的侄子吧？葬礼的事，节哀。她一直留着你小时候的画。\",\n        \"你的右脸……不，对不起。我不该一直盯着看。\"\n      ]\n    },\n    \"waterman\": {\n      \"id\": \"waterman\",\n      \"name\": \"提水老人\",\n      \"atlas\": \"npcs_a\",\n      \"cell\": 2,\n      \"lines\": [\n        \"施工队从枯井里挖出了东西，警察拉了线。西边的楼梯通向美术馆前街。\",\n        \"楼梯一层一层地走。你小时候总跟着那个扎双马尾的女孩跑上跑下。\"\n      ]\n    },\n    \"seamstress\": {\n      \"id\": \"seamstress\",\n      \"name\": \"缝衣匠\",\n      \"atlas\": \"npcs_a\",\n      \"cell\": 3,\n      \"lines\": [\n        \"红线绷得太紧了。美工刀能割断它们，也能挡开那些坏掉的木偶。\",\n        \"后台那只双马尾布偶，是道具师沃伊德帮一个男孩缝好的。眼睛一直完好。\"\n      ]\n    },\n    \"bookseller\": {\n      \"id\": \"bookseller\",\n      \"name\": \"旧书商\",\n      \"atlas\": \"npcs_b\",\n      \"cell\": 0,\n      \"lines\": [\n        \"七面镜子，七个方向。旧报纸堆里，还压着一张没人领回的寻人启事。\",\n        \"纸上的指控，和纸上的证词，有时是同一句话。\"\n      ]\n    },\n    \"usher\": {\n      \"id\": \"usher\",\n      \"name\": \"检票人\",\n      \"atlas\": \"npcs_b\",\n      \"cell\": 1,\n      \"lines\": [\n        \"戏还没散场。顺着红线往上，找到后台的门。\",\n        \"丰收祭那晚的演出，有两个孩子一直没有来。\"\n      ]\n    },\n    \"clocksmith\": {\n      \"id\": \"clocksmith\",\n      \"name\": \"钟表修理匠\",\n      \"atlas\": \"npcs_b\",\n      \"cell\": 2,\n      \"lines\": [\n        \"两枚印记就开得了钟楼。发条外庭的楼梯通往上层，不要跳过台阶。\",\n        \"你听得见齿轮的间隙了吗？握住那一瞬，时间就会慢下来。\"\n      ]\n    },\n    \"conductor\": {\n      \"id\": \"conductor\",\n      \"name\": \"站务员\",\n      \"atlas\": \"npcs_b\",\n      \"cell\": 3,\n      \"lines\": [\n        \"早班车七点开。离开，或者留下来把事情弄清楚，都可以。\",\n        \"这一次，可以出发了。\"\n      ]\n    },\n    \"detective\": {\n      \"id\": \"detective\",\n      \"name\": \"刑警\",\n      \"atlas\": \"detective\",\n      \"cell\": -1,\n      \"lines\": [\n        \"施工队在枯井下挖出的遗骸，已经确认是玲。明天请到局里配合调查。\",\n        \"你在询问时的表情……不太对劲。如果你记得什么，尽快告诉我。\",\n        \"井边的警戒线还在。别擅自下去——我们会再派人。\"\n      ]\n    }\n  },\n  \"enemies\": {\n    \"wax_walker\": {\n      \"id\": \"wax_walker\",\n      \"name\": \"僵硬的雕像\",\n      \"atlas\": \"enemies_a\",\n      \"cell\": 0,\n      \"hp\": 50,\n      \"speed\": 64,\n      \"damage\": 12,\n      \"behavior\": \"patrol\",\n      \"height\": 98,\n      \"range\": 80\n    },\n    \"wax_spitter\": {\n      \"id\": \"wax_spitter\",\n      \"name\": \"泼墨画像\",\n      \"atlas\": \"enemies_a\",\n      \"cell\": 1,\n      \"hp\": 65,\n      \"speed\": 25,\n      \"damage\": 14,\n      \"behavior\": \"ranged\",\n      \"height\": 110,\n      \"range\": 420\n    },\n    \"puppet\": {\n      \"id\": \"puppet\",\n      \"name\": \"断线木偶\",\n      \"atlas\": \"void_puppet\",\n      \"hp\": 45,\n      \"speed\": 105,\n      \"damage\": 13,\n      \"behavior\": \"lunge\",\n      \"height\": 104,\n      \"range\": 140\n    },\n    \"red_moth\": {\n      \"id\": \"red_moth\",\n      \"name\": \"红线飞蛾\",\n      \"atlas\": \"enemies_a\",\n      \"cell\": 3,\n      \"hp\": 30,\n      \"speed\": 90,\n      \"damage\": 9,\n      \"behavior\": \"fly\",\n      \"height\": 64,\n      \"range\": 110\n    },\n    \"mud_crawler\": {\n      \"id\": \"mud_crawler\",\n      \"name\": \"黑泥爬行者\",\n      \"atlas\": \"enemies_b\",\n      \"cell\": 0,\n      \"hp\": 60,\n      \"speed\": 88,\n      \"damage\": 14,\n      \"behavior\": \"patrol\",\n      \"height\": 67,\n      \"range\": 76\n    },\n    \"well_wisp\": {\n      \"id\": \"well_wisp\",\n      \"name\": \"井底回声\",\n      \"atlas\": \"enemies_b\",\n      \"cell\": 1,\n      \"hp\": 35,\n      \"speed\": 68,\n      \"damage\": 10,\n      \"behavior\": \"fly\",\n      \"height\": 100,\n      \"range\": 125\n    },\n    \"gear_sentry\": {\n      \"id\": \"gear_sentry\",\n      \"name\": \"发条哨兵\",\n      \"atlas\": \"enemies_b\",\n      \"cell\": 2,\n      \"hp\": 95,\n      \"speed\": 50,\n      \"damage\": 19,\n      \"behavior\": \"guard\",\n      \"height\": 116,\n      \"range\": 105\n    },\n    \"ember_resident\": {\n      \"id\": \"ember_resident\",\n      \"name\": \"火把下的人影\",\n      \"atlas\": \"enemies_b\",\n      \"cell\": 3,\n      \"hp\": 40,\n      \"speed\": 42,\n      \"damage\": 3,\n      \"behavior\": \"hesitant\",\n      \"height\": 103,\n      \"range\": 70\n    }\n  },\n  \"boss\": {\n    \"id\": \"morris\",\n    \"name\": \"梅·莫里 · 美术馆的主人\",\n    \"hp\": 840,\n    \"damage\": 22,\n    \"height\": 210,\n    \"phases\": 3,\n    \"attacks\": [\n      \"fan\",\n      \"cleave\",\n      \"slam\",\n      \"rush\",\n      \"copies\",\n      \"rain\"\n    ]\n  },\n  \"skills\": [\n    {\n      \"id\": \"notebook\",\n      \"stage\": \"初到镇口\",\n      \"keys\": \"J / 方向 + J\",\n      \"name\": \"调色刀挥击\"\n    },\n    {\n      \"id\": \"scissors\",\n      \"stage\": \"美术馆\",\n      \"keys\": \"J / K\",\n      \"name\": \"美工刀连击 / 美工刀突进\"\n    },\n    {\n      \"id\": \"double_jump\",\n      \"stage\": \"剧院后台\",\n      \"keys\": \"Space × 2\",\n      \"name\": \"记忆二段跳\"\n    },\n    {\n      \"id\": \"vine\",\n      \"stage\": \"剧院后台\",\n      \"keys\": \"W / S\",\n      \"name\": \"藤蔓攀爬\"\n    },\n    {\n      \"id\": \"dash\",\n      \"stage\": \"剧院后台\",\n      \"keys\": \"Shift\",\n      \"name\": \"解离冲刺\"\n    },\n    {\n      \"id\": \"time_slow\",\n      \"stage\": \"钟楼中层\",\n      \"keys\": \"Q\",\n      \"name\": \"发条缓时\"\n    }\n  ]\n}\nclass_name ExplorationBackdrop\nextends Node2D\n## Distant panorama and atmosphere only. Reachable architecture belongs to Room.\n\nvar room: Dictionary\nvar session: ExplorationSession\nvar theme: String = \"town\"\nvar far_layer: Node2D\nvar far_sprite: Sprite2D\nvar _time: float = 0.0\nvar _camera: Camera2D\n\nfunc _ready() -> void:\n\ttheme = str(room.get(\"theme\", \"town\"))\n\tif bool(room.get(\"vertical\",false)):\n\t\tfar_layer = Node2D.new()\n\telse:\n\t\tvar distant := Parallax2D.new()\n\t\tdistant.scroll_scale = Vector2(0.12,0.035)\n\t\tfar_layer = distant\n\tfar_layer.name = \"BG_04_Far\"\n\tfar_layer.z_index = -50\n\tadd_child(far_layer)\n\tfar_sprite = Sprite2D.new()\n\tfar_layer.add_child(far_sprite)\n\t_update_theme()\n\tsession.changed.connect(_update_theme)\n\nfunc _update_theme() -> void:\n\tvar display_theme: String = str(room.get(\"background\",theme))\n\tif session.stage >= 4 and theme == \"town\":\n\t\tdisplay_theme = \"fire\"\n\tif session.has(\"zero_loop\") and theme == \"town\":\n\t\tdisplay_theme = \"station\"\n\tvar path: String = \"res://assets/environments/exploration/backgrounds/\" + display_theme + \".png\"\n\tif bool(room.get(\"vertical\",false)) and not str(room.get(\"depth_background\",\"\")).is_empty():\n\t\tpath = \"res://assets/environments/exploration/depth/\"+str(room[\"depth_background\"])+\".png\"\n\tfar_sprite.texture = load(path) as Texture2D\n\tif far_sprite.texture == null:\n\t\treturn\n\tvar room_size: Vector2 = ExplorationCatalog.vec(room[\"size\"])\n\tvar width: float = 1500.0 + room_size.x * 0.12\n\tvar vertical: bool = bool(room.get(\"vertical\",false))\n\tvar height: float = 1100.0+room_size.y*.24 if vertical else 1000.0\n\tfar_sprite.scale = Vector2(width / far_sprite.texture.get_width(), height / far_sprite.texture.get_height())\n\tfar_sprite.position = Vector2(640+room_size.x*.06,360+room_size.y*(.12 if vertical else .0175))\n\tif vertical:\n\t\tfar_sprite.scale = (room_size+Vector2(120,120))/far_sprite.texture.get_size()\n\t\tfar_sprite.position = room_size*.5\n\tfar_sprite.modulate = Color(.55,.66,.73) if session.stage<4 else Color(.63,.48,.43)\n\nfunc _process(delta: float) -> void:\n\t_time += delta\n\tqueue_redraw()\n\nfunc _draw() -> void:\n\t_camera = get_viewport().get_camera_2d()\n\tif _camera == null:\n\t\treturn\n\tvar center: Vector2 = _camera.get_screen_center_position()\n\tvar rect := Rect2(center - Vector2(850, 520), Vector2(1700, 1040))\n\tvar fire: bool = theme == \"fire\" or session.stage >= 4\n\t# Thin, independently drifting mist bands separate middle planes without\n\t# concealing playable ledges or creating a bright opaque blanket.\n\tfor band: int in range(4):\n\t\tvar y: float = rect.position.y+430+band*100+sin(_time*.18+band)*18\n\t\tvar vertices := PackedVector2Array([Vector2(rect.position.x,y),Vector2(rect.end.x,y-20),Vector2(rect.end.x,y+85),Vector2(rect.position.x,y+75)])\n\t\tvar tint := Color(.2,.32,.38,.032) if not fire else Color(.32,.18,.13,.025)\n\t\tdraw_polygon(vertices,PackedColorArray([Color(tint,0),Color(tint,0),tint,tint]))\n\tfor i: int in range(50):\n\t\tvar x: float = fposmod(i * 173.2 + sin(_time * 0.1 + i) * 38.0 + _time * (14 if fire else 5), 1700)\n\t\tvar y: float = fposmod(i * 71.5 - _time * (35 if fire else 9), 1040)\n\t\tvar color := Color(1, 0.55, 0.2, 0.4) if fire else Color(0.62, 0.82, 0.87, 0.14)\n\t\tdraw_circle(rect.position + Vector2(x, y), 1.0 + i % 3 * 0.5, color)\n\tif str(room.get(\"id\",\"\")) == \"dry_well\":\n\t\tfor i: int in range(100):\n\t\t\tvar point: Vector2 = rect.position + Vector2(fposmod(i*73.7+_time*130,1700),fposmod(i*139.9+_time*720,1040))\n\t\t\tdraw_line(point,point+Vector2(8,24),Color(.6,.75,.85,.18),1,true)\n\t\tif fposmod(_time,11.0)<.09:\n\t\t\tdraw_rect(rect,Color(.8,.9,1,.19))\nclass_name ExplorationLingHand\nextends Node2D\n## A hand up out of the mud: a ripple of warning, then it closes on whatever ankle stands there.\n\nvar boss: ExplorationLingBoss\nvar session: ExplorationSession\nvar warning: float = .8\nvar _age: float = 0\nvar _closed: bool = false\nvar _holding: bool = false\n\nfunc _ready() -> void:\n\tz_index = 7\n\tadd_to_group(\"ling_owned\")\n\tadd_to_group(\"ling_hands\")\n\nfunc let_go() -> void:\n\t_holding = false\n\nfunc _physics_process(delta: float) -> void:\n\t_age += delta*(.3 if session.slow_time>0 else 1.0)\n\tposition.y = minf(boss.mud_y,boss.floor_y)\n\tif _age>=warning and not _closed:\n\t\t_closed = true\n\t\t_holding = boss.try_grab(position.x)\n\t\tget_node(\"/root/AudioManager\").play_sfx(\"sfx_mud_grab\")\n\tif not _holding and _age>=warning+.45:\n\t\tqueue_free()\n\tqueue_redraw()\n\nfunc _draw() -> void:\n\tvar mud := Color(\"3a2c1c\")\n\tif _age<warning:\n\t\tvar progress: float = clampf(_age/warning,0,1)\n\t\tvar marker: Texture2D = ExplorationArt.sprite(\"ground_hand\",-1,\"props\")\n\t\tif marker!=null:\n\t\t\tdraw_texture_rect(marker,Rect2(-42,-18,84,20),false,Color(1,1,1,.35+progress*.55))\n\t\treturn\n\tvar rise: float = 1.0 if _holding else sin(clampf((_age-warning)/.45,0,1)*PI)\n\t# A mud hand out of the mud (Codex art, Demo 9), rising and sinking back.\n\tvar hand: Texture2D = ExplorationArt.sprite(\"ling_hand\")\n\tif hand!=null and rise>.02:\n\t\tvar height: float = 96*rise\n\t\tvar width: float = 96*hand.get_width()/hand.get_height()\n\t\tdraw_texture_rect(hand,Rect2(Vector2(-width*.5,-height),Vector2(width,height)),false)\n\tdraw_line(Vector2(-24,0),Vector2(24,0),mud,6,true)\n#!/usr/bin/env python3\n\"\"\"Demo 9 scale/feet shares; compose existing artwork only, never redraw it.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,shutil,zipfile\nfrom PIL import Image,ImageDraw,ImageFont,ImageChops\nfrom export_demo9_share import ROOT,ACTORS,SETS,sheet as base_sheet\nfrom export_demo9_teammate_revision import panels\nSHARE=ROOT/'docs/demo9-share'\nBEFORE=Path('/tmp/demo9-scale-feet-before')\nNAMES=['may_brush_strike','void_lash','keeper_unmasked']\nwritten=[]\ndef sheet(names,cell=(280,420),cols=4,title=''):\n im=base_sheet(names,cell=cell,cols=cols,title=title);d=ImageDraw.Draw(im)\n font=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial Unicode.ttf',18)\n heading=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial Unicode.ttf',28)\n if title:\n  d.rectangle((0,0,im.width,66),fill=(18,22,28));d.text((24,24),title,font=heading,fill='#e9d19c')\n for i,n in enumerate(names):\n  x=24+(i%cols)*(cell[0]+24);y=24+(48 if title else 0)+(i//cols)*(cell[1]+60)+cell[1]\n  d.rectangle((x,y,x+cell[0],y+35),fill=(18,22,28));d.text((x,y+6),n.removesuffix('.png'),font=font,fill='#c8beaa')\n return im\ndef save(im,p):\n p.parent.mkdir(parents=True,exist_ok=True);im.save(p,optimize=True);written.append(str(p.relative_to(ROOT)))\ndef main():\n for n in NAMES+['may_brush']:\n  p=SHARE/'角色-立繪'/f'demo9-share-{n}.png';shutil.copy2(ACTORS/f'{n}.png',p);written.append(str(p.relative_to(ROOT)))\n overview=['may_brush_strike.png','void_lash.png','keeper_unmasked.png','fury_lunge.png','ling_giant.png','detective.png']\n im=sheet(overview,cell=(600,600),cols=3,title='Demo 9 · scale / feet revision')\n save(im,SHARE/'角色-合成/demo9-share-cast-overview.png');save(im,ROOT/'docs/demo9-compare-cast.png')\n all_poses=[]\n for group in ['may','void','fury','ling','keeper']:\n  names=SETS[f'demo9-share-cast-{group}.png'];all_poses.extend(names)\n  if group not in ['may','void','keeper']:continue\n  im=sheet(names,title='Demo 9 · '+group.upper())\n  for p in [SHARE/f'角色-合成/demo9-share-cast-{group}.png',SHARE/f'角色-姿勢/demo9-share-{group}-poses.png',ROOT/f'docs/demo9-compare-{group}-poses.png',ROOT/f'docs/demo9-compare-{group}.png']:save(im,p)\n save(sheet(all_poses+['detective.png'],title='Demo 9 · complete cast'),SHARE/'角色-合成/demo9-share-cast-full.png')\n for n in ['may-brush_strike','void-lash','keeper-unmasked']:\n  src=ROOT/f'docs/exploration-demo/v9-{n}.png'\n  dest=SHARE/f'角色-預覽/demo9-share-preview-{n}.png'\n  shutil.copy2(src,dest);written.append(str(dest.relative_to(ROOT)))\n previews=[ROOT/f'docs/exploration-demo/v9-{n}.png' for n in ['may-brush','may-brush_strike','void-lash','fury-lunge','ling-giant']]\n save(panels(previews,[p.stem for p in previews],2,(960,540)),ROOT/'docs/demo9-compare-v9-previews.png')\n # Full original canvases at IDENTICAL scale per before/after pair: no per-image crop/fit.\n font=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial Unicode.ttf',28)\n small=ImageFont.truetype('/System/Library/Fonts/Supplemental/Arial Unicode.ttf',20)\n canvas=Image.new('RGB',(2100,1500),(18,22,28));d=ImageDraw.Draw(canvas)\n d.text((32,15),'Demo 9 · 角色放大／腳朝向修正',font=font,fill='#e9d19c')\n d.text((32,56),'改前／改後使用同一完整畫布與相同比例；來源：本輪開始前備份 vs 遊戲現檔',font=small,fill='#bdb8aa')\n for col,n in enumerate(NAMES):\n  x=col*700;d.text((x+24,100),f'{col+1}  {n}',font=font,fill='#e9d19c')\n  for row,folder in enumerate([BEFORE,ACTORS]):\n   im=Image.open(folder/f'{n}.png').convert('RGBA');s=min(650/im.width,500/im.height)\n   tile=im.resize((round(im.width*s),round(im.height*s)),Image.Resampling.LANCZOS)\n   y=148+row*635;d.text((x+24,y),'改前' if row==0 else '改後',font=font,fill='#f1e7cf')\n   canvas.paste(tile,(x+(700-tile.width)//2,y+55+500-tile.height),tile)\n   d.rectangle((x+16,y+48,x+684,y+558),outline='#404955',width=1)\n  if n=='keeper_unmasked':\n   # Foot detail shares the same crop rectangle and scale in both rows.\n   for row,folder in enumerate([BEFORE,ACTORS]):\n    im=Image.open(folder/f'{n}.png').convert('RGBA').crop((15,1050,485,1270));im.thumbnail((300,150),Image.Resampling.LANCZOS)\n    xx=x+380;yy=148+row*635+398\n    d.rectangle((xx-5,yy-28,x+680,yy+151),fill='#202630',outline='#77715f')\n    d.text((xx,yy-26),'腳部細節',font=small,fill='#e9d19c');canvas.paste(im,(xx,yy),im)\n p=SHARE/'場景-對比/demo9-chars-scale-feet-before-after.png';save(canvas,p)\n # Preserve all other handoff contents, refresh archive after adding comparison.\n with zipfile.ZipFile(ROOT/'docs/demo9-share.zip','w',zipfile.ZIP_DEFLATED) as z:\n  for p in sorted(SHARE.rglob('*')):\n   if p.is_file() and p.su